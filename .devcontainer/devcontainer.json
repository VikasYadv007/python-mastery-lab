{
  "name": "Python Mastery Lab",
  "image": "mcr.microsoft.com/devcontainers/python:1-3.14-bookworm",
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "ms-python.vscode-pylance",
        "charliermarsh.ruff"
      ]
    },
    "codespaces": {
      "openFiles": [
        "README.md",
        "app.py"
      ]
    }
  },
  "postCreateCommand": "python -m pip install -r requirements-dev.txt",
  "forwardPorts": [
    8501
  ],
  "portsAttributes": {
    "8501": {
      "label": "Python Mastery Lab",
      "onAutoForward": "notify"
    }
  }
}
